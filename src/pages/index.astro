---
import Base from "../layouts/Base.astro";
import Latest from "../components/Latest.astro";
import roadmap from "../data/roadmap.json";

// The roadmap section shows what is being worked on now, straight from the board.
const now = [
  ...roadmap.items.filter((i) => i.column === "In progress"),
  ...roadmap.items.filter((i) => i.column === "Next"),
].slice(0, 6);
---
<Base bodyClass="home">
  <Fragment slot="rail">
  <aside class="rail" aria-hidden="true">
      <div class="rail-ruler">
        <span class="rail-progress mono"><b data-progress>0</b>%</span>
        <i class="rail-cursor"></i>
      </div>
      <ol class="rail-index">
        <li data-rail="top">Breadslicer</li>
        <li data-rail="workflow">Workflow</li>
        <li data-rail="labs">Close-ups</li>
        <li data-rail="native">Native</li>
        <li data-rail="roadmap">Roadmap</li>
        <li data-rail="download">Early access</li>
      </ol>
    </aside>
  </Fragment>


    <!-- ============ HERO ============ -->
    <section class="hero" id="hero" data-section="top" aria-labelledby="hero-title">
      <div class="hero-pin">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Native MSLA slicer · Early access</p>
            <p class="hero-wordmark" aria-hidden="true"><span class="reveal-words">Breadslicer</span></p>
            <h1 id="hero-title" class="reveal-words">A resin slicer that cuts <em>clean.</em></h1>
            <p class="lede">
              Written in Rust with its own GPU viewport. Tree supports and voxel
              hollowing that run at full speed, a layer view you can actually read.
              Nothing in a browser tab, nothing waiting on a spinner.
            </p>
            <div class="cta-row">
              <a class="button button-primary" href="#download" data-magnetic>Get early access</a>
              <a class="button button-ghost" href="#workflow" data-magnetic>See the workflow <span class="arrow" aria-hidden="true">→</span></a>
            </div>
            <dl class="hero-facts">
              <div><dt>Runtime</dt><dd>Native Rust</dd></div>
              <div><dt>Viewport</dt><dd>Own wgpu renderer</dd></div>
              <div><dt>Footprint</dt><dd>~48 MB executable</dd></div>
            </dl>
          </div>

          <div class="hero-art">
            <figure class="build" data-build aria-labelledby="build-caption">
              <div class="build-stage">
                <canvas class="build-canvas" data-build-canvas role="img"
                        aria-label="A wolverine miniature with its supports, built up from its 913 real layers as the page scrolls."></canvas>
                <div class="build-readout mono" aria-hidden="true">
                  <span>layer <b data-build-layer>1</b> / 913</span>
                  <span>z <b data-build-z>0.1</b> mm</span>
                </div>
                <div class="build-inset" aria-hidden="true">
                  <canvas data-build-flat></canvas>
                  <span class="mono">this layer</span>
                </div>
              </div>
              <figcaption id="build-caption" class="build-caption mono small">
                <span>The real layers of a 91 mm miniature, sliced by Breadslicer.</span>
                <span class="build-caption-dim">Scroll to build it.</span>
              </figcaption>
            </figure>
          </div>
        </div>
        <p class="scroll-hint mono" aria-hidden="true">Scroll to build</p>
      </div>
    </section>

    <!-- ============ TICKER ============ -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        <span>G / R / S gestures</span><span>Voxel hollowing</span><span>Trunks</span><span>Branches</span><span>Leaves</span><span>Braces</span><span>Rafts</span><span>Drain holes</span><span>32× layer view</span><span>Background pre-compute</span><span>One undo per click</span><span>Rust + Slint + wgpu</span>
        <span>G / R / S gestures</span><span>Voxel hollowing</span><span>Trunks</span><span>Branches</span><span>Leaves</span><span>Braces</span><span>Rafts</span><span>Drain holes</span><span>32× layer view</span><span>Background pre-compute</span><span>One undo per click</span><span>Rust + Slint + wgpu</span>
      </div>
    </div>

    <Latest />

    <!-- ============ WORKFLOW (scroll-driven) ============ -->
    <section class="section" id="workflow" data-section="workflow" aria-labelledby="workflow-title">
      <div class="section-bar">
        <span class="mono">01 / Workflow</span>
        <span class="mono section-bar-right"><span data-step-label>Transform</span> · <span data-step-count>1</span> of 5</span>
      </div>

      <header class="section-head">
        <h2 id="workflow-title">Five tabs, left to right. <em>Done.</em></h2>
        <p class="section-lede">
          The whole job lives in one tab bar, in the order you actually work. These
          are real captures of the app, and every time on this page was measured on
          one real run with the model below: scroll and the run plays back.
        </p>
      </header>

      <div class="story" data-story>
        <div class="story-stage">
          <div class="stage" data-stage data-step="1">
            <div class="stage-bar mono">
              <span class="stage-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="stage-tabs"><b data-tab="1">Transform</b><b data-tab="2">Hollow</b><b data-tab="3">Supports</b><b data-tab="4">Slice</b><b data-tab="5">Export</b></span>
              <span class="badge">Breadslicer</span>
            </div>
            <div class="stage-shots">
              <img class="shot" data-shot="1" src="/assets/shots/transform.webp" width="1600" height="900" alt="Breadslicer's Transform tab: a model on the build plate, moved with a live distance readout." fetchpriority="low">
              <img class="shot" data-shot="2" src="/assets/shots/hollow.webp" width="1600" height="900" alt="Breadslicer's Hollow tab: the model with its translucent cavity preview and the wall thickness controls." loading="lazy">
              <img class="shot" data-shot="3" src="/assets/shots/supports.webp" width="1600" height="900" alt="Breadslicer's Supports tab: tree supports generated under a miniature." loading="lazy">
              <img class="shot" data-shot="4" src="/assets/shots/slice.webp" width="1600" height="900" alt="Breadslicer's Slice tab: the model cut at a layer next to that layer's pixels, with time and resin estimates." loading="lazy">
              <img class="shot" data-shot="5" src="/assets/shots/export.webp" width="1600" height="900" alt="Breadslicer's Export tab: writing the print file for the selected printer." loading="lazy">
            </div>
          </div>
          <div class="runlog" data-runlog aria-label="Measured timings of one real run">
            <div class="runlog-head mono">
              <span><i class="runlog-dot" aria-hidden="true"></i>One real run, measured</span>
              <span>you waited <b data-waited>0.00</b> s</span>
            </div>
            <ol class="runlog-list mono">
              <li data-log-step="1" data-wait="0.56"><span class="log-t">0.56 s</span><span class="log-what">Window ready</span></li>
              <li data-log-step="1" data-wait="0.39"><span class="log-t">0.39 s</span><span class="log-what">Opened wolverine-breadslicer.stl</span><span class="log-note">92 MB · 1.9 M triangles</span></li>
              <li data-log-step="2" data-wait="0.87"><span class="log-t">0.87 s</span><span class="log-what">Live cavity preview</span><span class="log-note">wall 2 mm</span></li>
              <li data-log-step="2" data-wait="0" data-bg><span class="log-t">1.7 s</span><span class="log-what">Background: model scanned for supports</span><span class="log-note">while you look at the cavity</span></li>
              <li data-log-step="2" data-wait="0" data-bg><span class="log-t">3.2 s</span><span class="log-what">Background: supports generated ahead</span><span class="log-note">ready before you ask</span></li>
              <li data-log-step="3" data-wait="0.15"><span class="log-t">0.15 s</span><span class="log-what">Generate → supports on screen</span><span class="log-note">taken from the run made ahead</span></li>
              <li data-log-step="4" data-wait="0.66"><span class="log-t">0.66 s</span><span class="log-what">991 layers sliced</span><span class="log-note">1 h 49 m · 62.6 ml · 81.3 g</span></li>
              <li data-log-step="5" data-wait="0.12"><span class="log-t">0.12 s</span><span class="log-what">Printer file written</span><span class="log-note">.ctb · 26.9 MB · Saturn 3 Ultra</span></li>
            </ol>
          </div>
        </div>

        <div class="story-steps">
          <article class="story-step" data-step-index="1" id="step-transform">
            <p class="kicker">01 · Transform</p>
            <h3>Move it like you mean it.</h3>
            <p>Press <kbd>G</kbd>, <kbd>R</kbd> or <kbd>S</kbd> and drag. A live chip reads distance or degrees as you go, and axis guide lines keep you honest. Or type it in the numeric inspector: position, lift, rotation, size.</p>
            <p class="measure"><span class="measure-t mono">0.39 s</span> to open a 92 MB, 1.9-million-triangle miniature</p>
          </article>
          <article class="story-step" data-step-index="2" id="step-hollow">
            <p class="kicker">02 · Hollow</p>
            <h3>Save resin without guessing.</h3>
            <p>A translucent cavity preview that follows the wall slider live, a Recommended thickness one click away, fine ±0.1 and ±1 mm steps, and drain holes before or after.</p>
            <p class="measure"><span class="measure-t mono">0.87 s</span> for the live cavity. Meanwhile the supports are being made in the background.</p>
          </article>
          <article class="story-step" data-step-index="3" id="step-supports">
            <p class="kicker">03 · Supports</p>
            <h3>Hold it up, by hand or in one click.</h3>
            <p>Trunks, branches, leaves, braces and rafts, prepared in the background while you worked, so <em>Generate</em> is often instant. Add with <kbd>A</kbd>, remove with <kbd>X</kbd>, with a live preview before every click.</p>
            <p class="measure"><span class="measure-t mono">0.15 s</span> from Generate to the supports on screen: they were ready before the click</p>
          </article>
          <article class="story-step" data-step-index="4" id="step-slice">
            <p class="kicker">04 · Slice</p>
            <h3>Read every layer before the printer does.</h3>
            <p>Print time, resin and weight. Then a split view that zooms to 32× with crisp, honest pixels. Sealed cavities slice correctly: what you see is what gets exposed.</p>
            <p class="measure"><span class="measure-t mono">0.66 s</span> to slice 991 layers</p>
          </article>
          <article class="story-step" data-step-index="5" id="step-export">
            <p class="kicker">05 · Export</p>
            <h3>Write the file. Go print.</h3>
            <p>The file your printer reads, written before you can blink: every layer is encoded on every core, and the bytes are the same as a careful one-layer-at-a-time write. Your project keeps its state, so a last-minute fix is one tab away.</p>
            <p class="measure"><span class="measure-t mono">0.12 s</span> to write the 26.9 MB printer file, every layer encoded on every core</p>
          </article>
        </div>
      </div>

      <aside class="verify" aria-labelledby="verify-title">
        <p class="verify-kicker mono"><span class="verify-dot" aria-hidden="true"></span>Every number above is checkable</p>
        <h3 id="verify-title" class="verify-title">Don’t take our word for it.<br><em>Time it yourself.</em></h3>
        <p class="verify-lede">Benchmarks on a slicer’s own website are easy to fake. So here is the exact model from this run, and the app writes its own timings. Run it on your machine and compare.</p>

        <ol class="verify-steps">
          <li>
            <span class="verify-n mono">01</span>
            <h4>Get the same model</h4>
            <p>The wolverine, posed exactly as in this run. Binary STL, 1.9 million triangles.</p>
            <a class="button button-primary" href="https://github.com/breadslicer-app/breadslicer.app/releases/download/sample-wolverine/wolverine-breadslicer.zip" data-magnetic>Download the model <span class="button-sub">39 MB zip</span></a>
          </li>
          <li>
            <span class="verify-n mono">02</span>
            <h4>Turn on the log</h4>
            <p><span class="mono small">Preferences → Privacy →</span> <em>Save a diagnostic log until Breadslicer closes</em>. It is off by default, turns itself off next time, and never leaves your computer.</p>
          </li>
          <li>
            <span class="verify-n mono">03</span>
            <h4>Read the clock</h4>
            <p>Open, hollow, generate, slice, export. Then <em>Open logs folder</em> on the same page: <code>session.log</code> has the start and end of every step.</p>
          </li>
        </ol>

        <div class="verify-foot">
          <dl class="verify-rig mono">
            <div><dt>Our machine</dt><dd>Ryzen 7 5800X · RTX 3090 · 32 GB · NVMe SSD</dd></div>
            <div><dt>Printer</dt><dd>ELEGOO Saturn 3 Ultra · 0.1 mm layers</dd></div>
            <div><dt>Supports</dt><dd>Detail preset, defaults</dd></div>
            <div><dt>Build</dt><dd>Early access, 27 Oct 2026</dd></div>
          </dl>
          <p class="verify-promise">Slower on your machine? <strong>That’s a bug, and we want to hear about it.</strong></p>
        </div>
      </aside>
    </section>

    <!-- ============ CLOSE-UPS (real recordings) ============ -->
    <section class="section" id="labs" data-section="labs" aria-labelledby="labs-title">
      <div class="section-bar">
        <span class="mono">02 / Close-ups</span>
        <span class="mono section-bar-right">Real recordings · no mockups</span>
      </div>
      <header class="section-head">
        <h2 id="labs-title">The details you <em>feel.</em></h2>
        <p class="section-lede">
          Four short recordings of the app at work, on the same miniature. The small
          things that make an evening of preparing prints feel quick.
        </p>
      </header>

      <div class="cells">
        <article class="cell" data-cell>
          <div class="cell-head mono"><span>Transform · G, R, S on X, Y, Z</span><span>01</span></div>
          <div class="clip-frame" data-clipset>
              <video class="clip is-on" data-clip muted playsinline loop preload="none" poster="/assets/clips/transform.webp" width="960" height="720"><source src="/assets/clips/transform.mp4" type="video/mp4"></video>
            <span class="clip-badge mono">recorded in Breadslicer</span>
          </div>
          <div class="cell-body">
            <h3>Gestures with a readout.</h3>
            <p>Move with <kbd>G</kbd>, rotate with <kbd>R</kbd>, scale with <kbd>S</kbd>, and lock any of them to <kbd>X</kbd>, <kbd>Y</kbd> or <kbd>Z</kbd>. A chip reads the distance, degrees or scale as you go, and the plate turns red the moment the model leaves it.</p>
          </div>
        </article>
        <article class="cell" data-cell>
          <div class="cell-head mono"><span>Supports · A to add, X to remove</span><span>02</span></div>
          <div class="clip-frame" data-clipset>
              <video class="clip is-on" data-clip muted playsinline loop preload="none" poster="/assets/clips/supports.webp" width="960" height="720"><source src="/assets/clips/supports.mp4" type="video/mp4"></video>
            <span class="clip-badge mono">recorded in Breadslicer</span>
          </div>
          <div class="cell-body">
            <h3>See it before you click.</h3>
            <p>With <kbd>A</kbd> a green support follows the cursor, already routed to the plate. With <kbd>X</kbd> everything that would go turns red. One undo per click.</p>
          </div>
        </article>
        <article class="cell" data-cell>
          <div class="cell-head mono"><span>Hollow · wall thickness</span><span>03</span></div>
          <div class="clip-frame" data-clipset>
              <video class="clip is-on" data-clip muted playsinline loop preload="none" poster="/assets/clips/hollow.webp" width="960" height="720"><source src="/assets/clips/hollow.mp4" type="video/mp4"></video>
            <span class="clip-badge mono">recorded in Breadslicer</span>
          </div>
          <div class="cell-body">
            <h3>The cavity, live.</h3>
            <p>The translucent cavity follows the wall setting as you change it: ±1 and ±0.1 mm steps, and a Recommended thickness for this model one click away.</p>
          </div>
        </article>
        <article class="cell" data-cell>
          <div class="cell-head mono"><span>Slice · one real layer, 1× to 32×</span><span>04</span></div>
          <div class="clip-frame" data-clipset>
              <video class="clip is-on" data-clip muted playsinline loop preload="none" poster="/assets/clips/zoom.webp" width="960" height="960"><source src="/assets/clips/zoom.mp4" type="video/mp4"></video>
            <span class="clip-badge mono">real layer · sliced by Breadslicer</span>
          </div>
          <div class="cell-body">
            <h3>Every pixel, honestly.</h3>
            <p>A real layer of this miniature at the printer’s own pixels (19 µm on a Saturn 3 Ultra). Zoom to 32× with no smoothing: what you see is what the screen exposes.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- ============ NATIVE ============ -->
    <section class="section" id="native" data-section="native" aria-labelledby="native-title">
      <div class="section-bar">
        <span class="mono">03 / Built native</span>
        <span class="mono section-bar-right">Rust · Slint · wgpu</span>
      </div>

      <div class="why">
        <p class="why-kicker mono"><span class="why-dot" aria-hidden="true"></span>Why native</p>
        <h2 id="native-title" class="why-title">Because waiting is<br><em>not a feature.</em></h2>
        <p class="why-lede">
          Most desktop apps today are a website in a window: a whole browser engine shipped
          inside, sitting between you and your model. Every click goes through it. We wrote
          Breadslicer from scratch in Rust, with its own GPU renderer, so nothing sits in between.
          You feel it in the first second, and in every second after.
        </p>

        <div class="why-stats">
          <article class="why-stat">
            <span class="why-num mono">0.56<small>s</small></span>
            <h3>From click to a working window.</h3>
            <p>Then 0.39 s to open a 92 MB, 1.9-million-triangle miniature. No splash screen to watch.</p>
          </article>
          <article class="why-stat">
            <span class="why-num mono">16<small>cores</small></span>
            <h3>Your whole machine, not one thread of it.</h3>
            <p>On our 16-core test machine, 991 layers are encoded at once and written in 0.12 s. Supports are prepared on the spare cores while you look at the cavity.</p>
          </article>
          <article class="why-stat">
            <span class="why-num mono">47<small>MB</small></span>
            <h3>One file. No browser inside.</h3>
            <p>A single executable that talks to the GPU through DirectX 12, Vulkan or Metal, directly.</p>
          </article>
        </div>

        <div class="why-versus" role="table" aria-label="A website in a window compared with Breadslicer">
          <div class="why-row why-head" role="row">
            <span role="columnheader"></span>
            <span role="columnheader" class="mono">A website in a window</span>
            <span role="columnheader" class="mono">Breadslicer</span>
          </div>
          <div class="why-row" role="row">
            <span role="rowheader">What ships</span>
            <span role="cell">Your app plus a full browser engine</span>
            <span role="cell">One 47 MB executable</span>
          </div>
          <div class="why-row" role="row">
            <span role="rowheader">Path to the screen</span>
            <span role="cell">Script, then browser, then compositor, then GPU</span>
            <span role="cell">Rust, then your GPU</span>
          </div>
          <div class="why-row" role="row">
            <span role="rowheader">Heavy work</span>
            <span role="cell">Competes with the interface</span>
            <span role="cell">Runs on the other cores; the interface never waits</span>
          </div>
          <div class="why-row" role="row">
            <span role="rowheader">Memory safety</span>
            <span role="cell">A garbage collector pausing when it likes</span>
            <span role="cell">Checked at compile time, no collector in the loop</span>
          </div>
        </div>

        <ul class="why-chips mono" aria-label="Built with">
          <li>Rust, end to end</li>
          <li>Slint native UI</li>
          <li>Own wgpu renderer</li>
          <li>Cancel, undo and stale-result safe background jobs</li>
          <li>Byte-for-byte reference checks</li>
          <li>AGPL-3.0 free software</li>
        </ul>
      </div>
    </section>

    <!-- ============ ROADMAP ============ -->
    <section class="section" id="roadmap" data-section="roadmap" aria-labelledby="roadmap-title">
      <div class="section-bar">
        <span class="mono">04 / Roadmap</span>
        <span class="mono section-bar-right">Straight from our board, no dates</span>
      </div>
      <header class="section-head">
        <h2 id="roadmap-title">What's in the <em>oven.</em></h2>
      </header>
      <ol class="roadmap">
        {now.map((item) => (
          <li data-cell><span class="tag">{item.column}</span><div><h3>{item.title}</h3><p>{item.labels.filter((l) => l.startsWith("area: ")).map((l) => l.slice(6)).join(" · ") || " "}</p></div></li>
        ))}
      </ol>
      <p class="wrap" style="margin-top:24px"><a class="button button-ghost" href="/roadmap/" data-magnetic>The whole board, as it is <span class="arrow" aria-hidden="true">→</span></a></p>
    </section>

    <!-- ============ DOWNLOAD ============ -->
    <section class="section section-cta" id="download" data-section="download" aria-labelledby="download-title">
      <div class="section-bar">
        <span class="mono">05 / Early access</span>
        <span class="mono section-bar-right">Small batches while the edges get sanded</span>
      </div>
      <div class="cta-grid">
        <div>
          <h2 id="download-title">First slices, <em>soon.</em></h2>
          <p class="section-lede">Breadslicer is in early access. Builds are being handed out in small batches. The download will appear here.</p>
          <div class="cta-row">
            <a class="button button-primary is-soon" href="#download" aria-describedby="download-note" data-magnetic>Download <span class="button-sub">Coming soon</span></a>
            <a class="button button-ghost" href="/community/" data-magnetic>Community &amp; support <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <p id="download-note" class="small muted">No sign-up form yet. When early access opens, this page is where it opens.</p>
        </div>
        <div class="cta-art" aria-hidden="true" data-parallax="0.12">
          <img src="/assets/loaf-640.webp" width="640" height="640" alt="" loading="lazy">
        </div>
      </div>
    </section>
  
  <script is:inline slot="scripts" src="/main.js" defer></script>
</Base>
